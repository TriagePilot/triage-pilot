NODE_ENV=production
APP_BASE_URL=http://localhost:8787
TRIAGEPILOT_POSTGRES_BIND=127.0.0.1
TRIAGEPILOT_POSTGRES_PORT=5432
DATABASE_URL=postgres://triagepilot:triagepilot@postgres:5432/triagepilot
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_PASSWORD_FILE=
SESSION_SECRET=replace-with-session-secret-at-least-32-characters
SESSION_SECRET_FILE=
GITHUB_ORGANIZATION=replace-with-github-organization
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_PRIVATE_KEY=replace-with-pem-using-literal-backslash-n-line-breaks
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_WEBHOOK_SECRET_FILE=
WORKER_POLL_MS=2000
