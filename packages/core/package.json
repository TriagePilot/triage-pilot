{
  "name": "@triagepilot/core",
  "version": "1.1.1",
  "license": "FSL-1.1-Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TriagePilot/triage-pilot.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepare-package.mjs --package .",
    "postpack": "node ../../scripts/prepare-package.mjs --package . --cleanup"
  },
  "dependencies": {
    "@triagepilot/contracts": "workspace:1.1.1",
    "minimatch": "^10.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
