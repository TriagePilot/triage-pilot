{
  "name": "@triagepilot/contracts",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepare-package.mjs --package .",
    "postpack": "node ../../scripts/prepare-package.mjs --package . --cleanup"
  },
  "publishConfig": {
    "access": "public"
  }
}
