{
  "name": "@triagepilot/application",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepare-package.mjs --package .",
    "postpack": "node ../../scripts/prepare-package.mjs --package . --cleanup"
  },
  "dependencies": {
    "@triagepilot/config": "workspace:0.1.0",
    "@triagepilot/contracts": "workspace:0.1.0",
    "@triagepilot/core": "workspace:0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
