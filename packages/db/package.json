{
  "name": "@triagepilot/db",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist", "migrations", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "prepack": "node ../../scripts/prepare-package.mjs --package .",
    "postpack": "node ../../scripts/prepare-package.mjs --package . --cleanup"
  },
  "dependencies": {
    "@triagepilot/contracts": "workspace:0.1.0",
    "kysely": "^0.28.17",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
